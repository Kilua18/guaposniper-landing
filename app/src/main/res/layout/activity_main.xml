<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/terminal_bg">

    <!-- Terminal output area -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:fadingEdge="vertical">

        <TextView
            android:id="@+id/terminalOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textColor="@color/terminal_text"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:typeface="monospace"
            android:textIsSelectable="true"
            android:lineSpacingExtra="2dp" />

    </ScrollView>

    <!-- Command input area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/terminal_input_bg"
        android:padding="4dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/promptLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$"
            android:textColor="@color/terminal_prompt"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingEnd="4dp" />

        <EditText
            android:id="@+id/commandInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:textColor="@color/terminal_text"
            android:textColorHint="@color/terminal_hint"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:hint="tape une commande..."
            android:inputType="text"
            android:imeOptions="actionSend"
            android:singleLine="true"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Envoyer"
            android:tint="@color/terminal_accent"
            android:padding="8dp" />

    </LinearLayout>

</LinearLayout>
